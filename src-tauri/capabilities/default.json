{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口与托盘弹窗权限",
  "windows": ["main", "tray-popover"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:event:default",
    "shell:default",
    "allow-get-server-info",
    "allow-open-main-window",
    "allow-quit-app",
    "allow-open-leetcode-login",
    "allow-capture-login-cookie",
    "allow-close-leetcode-login",
    "allow-open-leetcode-cloudflare-verification",
    "allow-open-embedded-browser",
    "allow-close-embedded-browser",
    "allow-open-in-system-browser"
  ]
}
